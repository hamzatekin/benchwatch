{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benchwatch",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
